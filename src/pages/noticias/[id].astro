---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PaginaTopo from '../../components/PaginaTopo.astro';
import { getNoticias, getComunidades, nomeComunidade, formatarData } from '../../lib/data';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((n) => ({ params: { id: n.id }, props: { noticia: n } }));
}
const { noticia } = Astro.props;
const { Content } = await render(noticia);
const comunidades = await getComunidades();
const n = noticia.data;
const origem = n.comunidade !== 'paroquia' ? nomeComunidade(n.comunidade, comunidades) : 'Paróquia';
---
<Base titulo={n.titulo} descricao={n.resumo ?? undefined} imagem={n.capa}>
  <PaginaTopo eyebrow={`${origem} · ${formatarData(n.data)}`} titulo={n.titulo} subtitulo={n.resumo} migalhas={[{ href: '/noticias/', texto: 'Notícias' }]} />
  <section class="section">
    <div class="container">
      <article class="prosa">
        {n.capa && <img src={n.capa} alt="" />}
        <Content />
      </article>
      <p style="margin-top:32px"><a class="link-seta" href="/noticias/">Voltar para as notícias</a></p>
    </div>
  </section>
</Base>
