---
interface Props { titulo: string; subtitulo?: string; claro?: boolean }
const { titulo, subtitulo } = Astro.props;
---
<div class="titulo-ornado">
  <h2>{titulo}</h2>
  <div class="ornamento"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3v18M6 9h12" /></svg></div>
  {subtitulo && <p>{subtitulo}</p>}
</div>
